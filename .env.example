# Project Harness - 环境变量模板
# 复制为 .env 并填写真实值：cp .env.example .env
# 注意: .env 已被 .gitignore 忽略，不会提交到仓库

# --- 数据库 ---
POSTGRES_PASSWORD=请填写强密码

# --- 后端 JWT ---
JWT_SECRET=请填写随机密钥（可用 openssl rand -hex 32 生成）
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS 允许的前端来源（逗号分隔）---
CORS_ORIGINS=http://localhost:8080,http://10.166.245.50:8080

# --- AI 模块 ---
# AI_API_KEY 为空时 AI 模块运行在 mock 模式（返回模拟回复，便于开发联调）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- 邮箱验证码 / SMTP ---
# 示例（QQ 邮箱，需开启 SMTP 并获取授权码）:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your_qq@qq.com
# SMTP_PASSWORD=你的授权码
# SMTP_FROM=your_qq@qq.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- GitHub OAuth（SSO 登录；留空则前端隐藏 GitHub 登录按钮） ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 站点对外地址：生产填 https://www.platformharness.ltd
PUBLIC_BASE_URL=http://localhost:5173
