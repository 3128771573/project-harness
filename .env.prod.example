# Project Harness · 生产环境变量模板（云服务器）
# 复制为 .env 并填写真实值：cp .env.prod.example .env
# 安全要求：所有密码/密钥必须替换为强随机值，禁止复用开发环境

# --- 数据库（用强随机密码） ---
# 生成: openssl rand -hex 16
POSTGRES_PASSWORD=请替换为强随机密码

# --- 后端 JWT（用强随机密钥） ---
# 生成: openssl rand -hex 32
JWT_SECRET=请替换为强随机密钥
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS 允许的前端来源（生产为域名，逗号分隔） ---
CORS_ORIGINS=https://your-domain.com,http://localhost:8080

# --- AI 模块 ---
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# --- 文件上传 ---
UPLOAD_DIR=/app/uploads
